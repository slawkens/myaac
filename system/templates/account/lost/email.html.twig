Please enter e-mail and the character name.<br/>
<br/>

{% set title = 'Please fill the form' %}
{% set content %}
<table style="width:100%;">
	<tbody>
		<tr>
			<td>
				<div class="TableContentContainer ">
					<table class="TableContent" width="100%">
						<tbody>
						<tr>

							<td>
								<label for="character">Character:</label>
							</td>
							<td>
								<input type="text" form="form" id="character" name="character" value="{{ '@' in character ? '' : character }}" size="40">
							</td>
						</tr>
						<tr>
							<td>
								<label for="email">E-mail to account:</label>
							</td>
							<td>
								<input type="email" form="form" id="email" name="email" value="{{ email }}" size="40">
							</td>
						</tr>
					</table>
				</div>
			</td>
		</tr>
	</tbody>
</table>

{% endset %}
{% include 'tables.headline.html.twig' %}

<br/>
<table style="width:100%">
	<tbody>
		<tr align="center">
			<td>
				<form id="form" action="{{ getLink('account/lost/email/send-code') }}" method="post">

					{{ csrf() }}

					{{ include('buttons.base.html.twig', {'button_name': 'Submit', 'button_color': 'green'})}}
				</form>
			</td>
			<td>
				<form action="{{ getLink('account/lost') }}" method="post">

					{{ csrf() }}

					{{ include('buttons.base.html.twig', {'button_name': 'Back'})}}
				</form>
			</td>
			<td></td>
		</tr>
	</tbody>
</table>
