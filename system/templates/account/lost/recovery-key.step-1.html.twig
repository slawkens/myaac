If you enter right recovery key you will see form to set new e-mail and password to account. To this e-mail will be send your new password and account name.<br/>
<br/>

<table class="myaac-table" style="width: 100%;">

	<thead>
	<tr>
		<th class="white">
			<b>Please enter your recovery key</b>
		</th>
	</tr>
	</thead>

	<tbody>
	<tr>
		<td>
			<table>
				<tr>
					<td>
						<label for="character">
							<strong>
								{% if '@' in character %}
								Email address:
								{% else %}
								Character name:
								{% endif %}
							</strong>
						</label>
					</td>
					<td>
						<input type="text" form="form" id="character" name="character" value="{{ character }}" size="40">
					</td>
				</tr>
				<tr>
					<td>
						<label for="key">
							<strong>Recovery key:</strong>
						</label>
					</td>
					<td>
						{{ include('account.recovery-key.html.twig') }}
					</td>
				</tr>
			</table>
		</td>
	</tr>
	</tbody>

</table>

<br/>
<table style="width:100%">
	<tbody>
		<tr align="center">
			<td>
				<form id="form" action="{{ getLink('account/lost/recovery-key/step-2') }}" method="post">

					{{ csrf() }}

					{{ include('buttons.base.html.twig', {'button_name': 'Submit', 'button_color': 'green'})}}
				</form>
			</td>
			<td>
				<form action="{{ getLink('account/lost') }}" method="post">

					{{ csrf() }}

					{{ include('buttons.base.html.twig', {'button_name': 'Back'})}}
				</form>
			</td>
			<td></td>
		</tr>
	</tbody>
</table>
