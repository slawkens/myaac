<div class="card card-info">
	<div class="card-header">
		<h3 class="card-title">Permissions</h3>
	</div>
	<div class="card-body">
		<form method="post">
			<input type="hidden" name="action" value="select-account">
			<div class="form-group">
				<label for="permission-account-id">Select account email</label>
				<input type="text" class="form-control" id="permission-account-id" name="account_email" placeholder="Enter account email" value="{{ selectedAccountEmail }}">
			</div>
			<div class="d-flex gap-2">
				<button type="submit" class="btn btn-primary">Continue</button>
				<button type="button" class="ml-2 btn btn-secondary js-permissions-cancel-account">Cancel</button>
			</div>
		</form>

		{% if showMatrix %}
			<hr>
			<form id="permissions-form" method="post">
				<input type="hidden" name="action" value="save">
				<input type="hidden" name="account_email" value="{{ selectedAccountEmail }}">
				<div class="alert alert-info">
					Editing permissions for account email <strong>{{ selectedAccountEmail }}</strong>.
				</div>
				<div class="d-flex gap-2 mb-3">
					<button type="submit" class="btn btn-primary">Save</button>
					<button type="button" class="ml-2 btn btn-secondary js-permissions-cancel">Cancel</button>
				</div>
				<div class="mb-2">
					<label for="web_flags" style="padding-top: 5px">Website Access:</label>
					<select name="web_flags" id="web_flags" class="form-control w-100">
						{% for id, name in constant('ACCOUNT_WEB_FLAGS') %}
							{% if id != 3 %}
								<option value="{{ id }}" {% if webFlags == id or (webFlags == 3 and id == 2) %}selected{% endif %}>{{ name }}</option>
							{% endif %}
						{% endfor %}
					</select>
				</div>
				<ul class="alert alert-secondary pl-4">
					<li><strong>None</strong> has no access to the admin panel.</li>
					<li><strong>Admin</strong> can set permissions for each page and operation. The permissions are saved in the database and will be applied to the selected account.</li>
					<li><strong>Super Admin</strong> can do everything, no matter the permissions.</li>
				</ul>

				<div id="permissions-container">
					{% for pageType in ['core', 'plugins'] %}

						<h2 class="text-center">
							{{ pageType == 'core' ? 'Core Pages' : 'Plugins Pages' }}
						</h2>
						<div>
							<table id="table-permissions" class="table table-striped table-bordered">
								<thead>
									<tr>
										<th class="text-right"><h3><strong>Page</strong></h3></th>
										<th class="text-center">
											<h3>View</h3>
											<button type="button" class="btn btn-sm btn-outline-secondary mt-1" data-select-column="view">Select all</button>
										</th>
										<th class="text-center">
											<h3>Add</h3>
											<button type="button" class="btn btn-sm btn-outline-secondary mt-1" data-select-column="add">Select all</button></th>
										<th class="text-center">
											<h3>Edit</h3>
											<button type="button" class="btn btn-sm btn-outline-secondary mt-1" data-select-column="edit">Select all</button>
										</th>
										<th class="text-center">
											<h3>Remove</h3>
											<button type="button" class="btn btn-sm btn-outline-secondary mt-1" data-select-column="remove">Select all</button>
										</th>
									</tr>
								</thead>
								<tbody>
									{% for name, page in pages[pageType] %}
										<tr>
											<td class="text-right">
												<strong>{{ page.label|raw }}</strong>
												<br>
												<small>{{ name }}</small>
												<br>
												<button type="button" class="btn btn-xs btn-outline-secondary mt-2" data-select-row="{{ name }}">Select row</button>
											</td>
											{% for operation in operations %}
												<td class="text-center">
													<input type="checkbox" class="permission-checkbox form-check-input {% if page.operations[operation] is not defined or not page.operations[operation] %}disabled{% endif %}" data-row="{{ name }}" data-operation="{{ operation }}" name="pages[{{ name }}][{{ operation }}]" value="1"{% if selected[name][operation] is defined %} checked{% endif %} {% if page.operations[operation] is not defined or not page.operations[operation] %}disabled{% endif %}>
													{% if page.descriptions[operation] is defined %}
														<br/><br/><br/>
														<small>{{ page.descriptions[operation] }}</small>
													{% endif %}

												</td>
											{% endfor %}
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					{% endfor %}
				</div>
				<div class="d-flex gap-2 mt-1">
					<button type="submit" class="btn btn-primary">Save</button>
					<button type="button" class="ml-2 btn btn-secondary js-permissions-cancel">Cancel</button>
				</div>
			</form>
		{% endif %}
	</div>
</div>
<script>
$(function () {
	$("#permissions-form").submit(function() {
		$("input").removeAttr("disabled");
	});

	$('.js-permissions-cancel').on('click', function () {
		const accountEmail = $('#permission-account-id').val() || '';
		const queryString = accountEmail ? '&account_email=' + accountEmail : '';
		window.location = '{{ constant("ADMIN_URL") }}?p=permissions' + queryString;
	});

	$('.js-permissions-cancel-account').on('click', function () {
		 window.location = '{{ constant("ADMIN_URL") }}?p=permissions';
	});

	function togglePermissionCheckboxesVisibility() {
		const webFlagsValue = Number($('#web_flags').val());
		if (webFlagsValue === 0) {
			$('#permissions-container').hide();
		} else {
			$('#permissions-container').show();
		}

		const shouldHideCheckboxes = (webFlagsValue === 2);
		$('.permission-checkbox:not(.disabled)').prop("disabled", shouldHideCheckboxes);
	}

	$('#web_flags').on('change', togglePermissionCheckboxesVisibility);
	togglePermissionCheckboxesVisibility();

	$('[data-select-column]').on('click', function () {
		const operation = $(this).data('select-column');
		const checkboxes = $('.permission-checkbox[data-operation="' + operation + '"]:not(.disabled)');
		const shouldCheck = !checkboxes.toArray().every(function (checkbox) {
			return checkbox.checked;
		});

		checkboxes.prop('checked', shouldCheck);
	});

	$('[data-select-row]').on('click', function () {
		const row = $(this).data('select-row');
		const checkboxes = $('.permission-checkbox[data-row="' + row + '"]:not(.disabled)');
		const shouldCheck = !checkboxes.toArray().every(function (checkbox) {
			return checkbox.checked;
		});

		checkboxes.prop('checked', shouldCheck);
	});
});
</script>
<style>
	.permission-checkbox {
		width: 3.5em;
		height: 3.5em;
	}

	#table-permissions thead th { position: sticky; top: 30px; z-index: 1; background-color: #f8f9fa; }
</style>
