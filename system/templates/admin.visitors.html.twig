<div class="card card-info card-outline">
	<div class="card-header">
		<h5 class="m-0">Users active within last {{ config_visitors_counter_ttl }} minutes.</h5>
	</div>
	<div class="card-body">
		<div class="form-check mb-3">
			<input class="filter form-check-input" type="checkbox" value="1" id="hide-bots">
			<label class="form-check-label" for="hide-bots">
				Hide Bots
			</label>
		</div>

		<table id="tb_visitors" class="table table-striped table-bordered table-responsive d-md-table">
			<thead>
			<tr>
				<th>IP</th>
				<th>Last visit</th>
				<th>Page</th>
				<th>Browser</th>
			</tr>
			</thead>
			<tbody>
			{% for visitor in visitors %}
				<tr>
					<td>{{ visitor.ip }}</td>
					<td>{{ visitor.lastvisit|date("H:i:s") }}</td>
					<td><a href="{{ visitor.page }}">{{ visitor.page|slice(0, 50) }}</a></td>
					<td>{{ visitor.browser|raw }}</td>
				</tr>
			{% endfor %}
			</tbody>
		</table>
	</div>
</div>
<script>
	$(function () {
		var hideBots = false;
		let table = $('#tb_visitors').DataTable({
			initComplete: function () {
				$.fn.dataTable.ext.search.push(
					function( settings, searchData, index, rowData, counter ) {
						// Don't display rows if hideBots is true and the row is a bot
						if (hideBots && searchData[3].includes('(Bot)')) {
							return false;
						}

						return true;
					}
				);
			}
		});

		$('.filter').on('change', function() {
			// Update the hideBots flag based on the checkbox state
			hideBots = $(this).prop('checked');

			table.draw();
		});
	});
</script>
