{% if newRecoveryKeyFormat %}

	<input form="form" class="upper-case-input" id="key1" name="key1" value="" size="5" maxlength="5" autocomplete="off" autofocus> -
	<input form="form" class="upper-case-input" id="key2" name="key2" value="" size="5" maxlength="5" autocomplete="off"> -
	<input form="form" class="upper-case-input" id="key3" name="key3" value="" size="5" maxlength="5" autocomplete="off"> -
	<input form="form" class="upper-case-input" id="key4" name="key4" value="" size="5" maxlength="5" autocomplete="off">

{% else %}
	<input form="form" class="upper-case-input" name="key" value="" autocomplete="off" autofocus>
{% endif %}

{% if newRecoveryKeyFormat %}
	<script>
		$("#key1, #key2, #key3, #key4").bind("paste", function(e) {
			let pastedData = e.originalEvent.clipboardData.getData('text');

			if (pastedData.includes('-')) {
				let splittedData = pastedData.split('-');

				$("#key1").val(splittedData[0]);
				$("#key2").val(splittedData[1]);
				$("#key3").val(splittedData[2]);
				$("#key4").val(splittedData[3]);
			}
		});
	</script>
{% endif %}
